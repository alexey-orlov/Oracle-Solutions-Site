{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oracle-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "site"
      ],
      "port": 8765
    },
    {
      "name": "oracle-site-alt",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-8767}\" --bind 127.0.0.1 --directory site"
      ],
      "port": 8767,
      "autoPort": true
    },
    {
      "name": "mail-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8766
    }
  ]
}
