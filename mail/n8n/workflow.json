    {
      "id": "send-practice",
      "name": "Send practice copy",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1540,
        220
      ],
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.mail.to }}",
        "subject": "={{ $json.mail.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.mail.text }}",
        "html": "={{ $json.mail.html }}",
        "options": {
