{
  "name": "Oracle site forms (cloud)",
  "nodes": [
    {
      "id": "form-post",
      "name": "Form POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        400
      ],
      "webhookId": "REDACTED",
      "parameters": {
        "httpMethod": "POST",
        "path": "REDACTED-see-.work/n8n/webhook-path.txt",
        "responseMode": "responseNode",
