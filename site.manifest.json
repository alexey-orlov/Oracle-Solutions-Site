{
  "$comment": "The mini-site's machine-readable description of itself. The oracle-packs-web plugin reads it before it edits, checks, previews or publishes this site. Change it in the same commit as the thing it describes. Prose rules live in docs/START-HERE.md; enforcement lives in tools/check-grammar.js.",
  "name": "Oracle AI & Data Solutions",
  "contract": {
    "round": 11,
    "asOf": "2026-09-23",
    "$comment": "Bump in any round that changes a content.js key, a config switch, a product tab, a checker rule or a publish rule. The plugin compares this with the round its own listing references were written against and defers to the site when the site is newer."
  },
  "startHere": "docs/START-HERE.md",
  "docs": {
    "schema": "docs/SCHEMA.md",
    "config": "docs/CONFIG.md",
    "visualGrammar": "docs/VISUAL-GRAMMAR.md",
    "theme": "docs/SS26-THEME.md",
    "assets": "docs/ASSETS.md",
    "provenance": "docs/PROVENANCE.md",
    "runbook": "docs/HANDOFF.md"
  },
  "paths": {
    "publishRoot": "site",
    "content": "site/data/content.js",
    "config": "site/data/config.js",
    "diagrams": "site/data/diagrams.js",
    "demos": "site/demo",
    "denyList": "tools/deny-list.json"
  },
  "checker": {
    "run": "node tools/check-grammar.js",
    "from": "repo root",
    "pass": "check-grammar: OK"
  },
  "exemplarProduct": "workforce-optimization",
  "preview": {
    "launchConfig": "oracle-site",
    "origin": "http://127.0.0.1:8765",
    "widths": [1440, 1280, 1024, 768, 375],
    "h1Width": 320
  },
  "publish": {
    "target": "https://claude.ai/artifact/HTEJADBQF3ZevFPuSoTHri",
    "neverPublishTo": [
      "https://claude.ai/artifact/98wafGUphFSyGSr6ctJiiN",
      "https://claude.ai/code/artifact/41e4f3b6-47d9-4ef2-af99-99c40c02b89b"
    ],
    "root": "site",
    "wrapper": {
      "from": "site/index.html",
      "to": ".work/publish/index.html",
      "stripExactLines": [
        "<!DOCTYPE html>",
        "<html lang=\"en\" data-theme=\"light\" data-brand=\"ss26\">",
        "<head>",
        "</head>",
        "<body>",
        "</body>",
        "</html>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
      ]
    },
    "contentTypes": {
      ".woff": "font/woff",
      ".woff2": "font/woff2",
      ".ttf": "font/ttf"
    },
    "neverInArtifact": [
      "index-legacy.html",
      "assets/site-legacy.css"
    ],
    "fullTree": "Every path the target's list_files already shows, plus the new files. Never the whole folder: the archived theme's files stay off this artifact.",
    "demoTargets": "site/data/config.js: products[<slug>].demoPreviewUrl"
  },
  "neverShip": {
    "paths": [
      "docs/asset-candidates/",
      "site/assets/img/logos/"
    ],
    "sweep": {
      "root": "site",
      "include": ["*.js", "*.css", "*.html"],
      "patterns": "every name on the practice deny-list, plus logos/"
    }
  }
}
