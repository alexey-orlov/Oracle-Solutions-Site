[
  { "sleep": 900 },
  { "shot": "00-gate" },
  { "click": "#gate-start" },
  { "sleep": 700 },
  { "assert": { "expr": "document.querySelector('#tour-step').textContent === 'Step 1 of 6 · 1 of 2'", "name": "step 1, part 1 of 2" } },
  { "shot": "01-check" },
  { "click": "#btn-check" },
  { "sleep": 800 },
  { "assert": { "expr": "document.querySelector('#tour-step').textContent === 'Step 1 of 6 · 2 of 2'", "name": "the counter moved inside step 1" } },
  { "shot": "02-run" },
  { "click": "#btn-run" },
  { "sleep": 4500 },
  { "shot": "03-running" },
  { "sleep": 6500 },
  { "assert": { "expr": "window.DEMO.tour.stepId() === 'band' && !document.querySelector('#tour-next').hidden", "name": "the passive value step shows Next" } },
  { "assert": { "expr": "!window.DEMO.tour.avoidHit()", "name": "the card does not cover the band" } },
  { "shot": "04-band" },
  { "click": "#tour-next" },
  { "sleep": 800 },
  { "assert": { "expr": "document.querySelector('#tour-step').textContent === 'Step 3 of 6 · 1 of 2'", "name": "step 3, part 1 of 2" } },
  { "click": ".kpi-tile[data-kpi=cost]" },
  { "sleep": 900 },
  { "shot": "05-drill" },
  { "assert": { "expr": "document.querySelector('#tour-step').textContent === 'Step 3 of 6 · 2 of 2'", "name": "the counter moved inside step 3" } },
  { "click": "#drill tr[data-cause='C1']" },
  { "sleep": 1000 },
  { "shot": "06-record" },
  { "assert": { "expr": "window.DEMO.tour.stepId() === 'reject' && !window.DEMO.tour.avoidHit()", "name": "reject step, the band stays visible" } },
  { "click": "#btn-reject-C3" },
  { "sleep": 1000 },
  { "assert": { "expr": "Math.round(window.DEMO.kpis().costShare * 100) === 88 && Math.round(window.DEMO.kpis().dayShare * 100) === 85", "name": "the band recomputed after the override" } },
  { "shot": "07-rejected" },
  { "click": "#btn-confirm-all" },
  { "sleep": 1000 },
  { "assert": { "expr": "Math.round(window.DEMO.kpis().costShare * 100) === 86 && window.DEMO.state.decisions.C7 === 'held'", "name": "the rest confirmed, the dispute held" } },
  { "shot": "08-confirmed" },
  { "click": "#nav-lessons" },
  { "sleep": 900 },
  { "shot": "09-lessons" },
  { "click": "#btn-export" },
  { "sleep": 1300 },
  { "assert": { "expr": "!document.querySelector('#gate').hidden && document.querySelectorAll('#gate-try button').length === 3", "name": "the end card renders its three doors" } },
  { "shot": "10-end" }
]
